{
  "manifest_version": 3,
  "name": "SoundCloud Overlay bridge",
  "version": "1.1.0",
  "description": "Local bridge: reports the SoundCloud tab's current track to the SC Overlay window and applies its transport commands.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://soundcloud.com/*", "https://www.soundcloud.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SC Overlay — настройки моста",
    "default_icon": "icon32.png"
  },
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*", "https://www.soundcloud.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon32.png",
    "32": "icon32.png",
    "48": "icon32.png",
    "128": "icon32.png"
  }
}
