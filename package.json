{
  "name": "sc-overlay",
  "productName": "SoundCloud Overlay",
  "version": "2.0.0",
  "description": "SoundCloud Overlay 2.0 — cross-platform (Windows/Linux) gaming overlay: mini-mode, animations, Discord RPC.",
  "main": "main.js",
  "author": "pandemias",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:all": "electron-builder --win nsis --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.scoverlay.app",
    "productName": "SoundCloud Overlay",
    "copyright": "dev: pandemias",
    "files": [
      "main.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "extraFiles": [
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "README_OVERLAY.md",
        "to": "README_OVERLAY.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "synopsis": "Gaming overlay for SoundCloud",
      "description": "SoundCloud Overlay — прозрачный оверлей поверх игр: текущий трек, управление воспроизведением, Discord Rich Presence, мини-режим.",
      "desktop": {
        "Name": "SoundCloud Overlay",
        "Comment": "Gaming overlay for SoundCloud",
        "Categories": "AudioVideo;Audio;Player;"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundCloud Overlay",
      "uninstallDisplayName": "SoundCloud Overlay",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}"
  }
}
